      Item 1
      Product Name: | "Widget A    "
      Price: | "$10.00      "
      [Remove]
      --
      Item 2
      Product Name: | "Widget B    "
      Price: | "$25.00      "
      [Remove]
    }
    [ + Add Product ]
  }
  ==
  [         Generate Document         ]
}
